# ==============================================================================
# NetSage Environment Configuration
# ==============================================================================

# Operating Mode: SIMULATED (In-Memory Realistic Engine) or GNS3_LIVE (Live GNS3 REST API)
TOPOLOGY_MODE=SIMULATED

# GNS3 Server Configuration (Only used when TOPOLOGY_MODE=GNS3_LIVE)
GNS3_SERVER_URL=http://localhost:3080
GNS3_PROJECT_NAME=NetSage_Enterprise_Topology

# Primary Cloud Inference (Meta Llama 3 via Groq)
# Get a free API key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Secondary Local Inference Fallback (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Fallback Gatekeeper Thresholds
MAX_RETRIEVAL_DISTANCE=0.85
MIN_CONFIDENCE_THRESHOLD=65
